# Server
PORT=8080
#BODY_LIMIT=10mb
#PUBLIC_URL=http://localhost:8080
#TRUST_PROXY=
#CORS_ORIGIN=
#REVISIUM_STANDALONE=1
#REVISIUM_ROBOTS_TXT=

# Database (required outside @revisium/standalone)
DATABASE_URL=

# Authentication
#JWT_SECRET=
#JWT_ACCESS_TOKEN_TTL=30m
#JWT_REFRESH_TOKEN_TTL_DAYS=7
#JWT_REFRESH_GRACE_PERIOD_MS=30000
#COOKIE_SECURE=
#COOKIE_SAMESITE=lax
#REVISIUM_NO_AUTH=false

# Default users
#ADMIN_PASSWORD=admin
#ENDPOINT_PASSWORD=endpoint

# OAuth and MCP
#OAUTH_GOOGLE_CLIENT_ID=
#OAUTH_GOOGLE_CLIENT_SECRET=
#OAUTH_GITHUB_CLIENT_ID=
#OAUTH_GITHUB_CLIENT_SECRET=
#MCP_ACCESS_TOKEN_EXPIRY_DAYS=30
#ENDPOINT_SERVICE_URL=

# Cache
#CACHE_ENABLED=false
#CACHE_L1_MAX_SIZE=128mb
#CACHE_L2_REDIS_URL=redis://localhost:6379/0
#CACHE_BUS_HOST=localhost
#CACHE_BUS_PORT=6379
#CACHE_DEBUG=false

# Transactions
#TRANSACTION_MAX_WAIT=10000
#TRANSACTION_TIMEOUT=15000
#TRANSACTION_MAX_RETRIES=20
#TRANSACTION_BASE_DELAY_MS=30
#TRANSACTION_MAX_DELAY_MS=1500

# File storage
#STORAGE_PROVIDER=
#FILE_PLUGIN_PUBLIC_ENDPOINT=
#STORAGE_LOCAL_PATH=./uploads
#S3_ENDPOINT=
#S3_REGION=
#S3_BUCKET=
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=

# Email
#EMAIL_TRANSPORT=
#EMAIL_PUBLIC_URL=
#EMAIL_FROM=
#REVISIUM_TEMPLATES_DIR=

# GraphQL customization
#GRAPHQL_HIDE_NODE_TYPES=false
#GRAPHQL_HIDE_FLAT_TYPES=false
#GRAPHQL_HIDE_MUTATIONS=false
#GRAPHQL_FLAT_POSTFIX=Flat
#GRAPHQL_NODE_POSTFIX=
#GRAPHQL_PREFIX_FOR_TABLES=
#GRAPHQL_PREFIX_FOR_COMMON=

# REST API customization
#RESTAPI_PREFIX_FOR_TABLES=
#RESTAPI_PREFIX_FOR_COMMON=

# Endpoint synchronization
#SYNC_INITIAL_BATCH_SIZE=100
#SYNC_PG_NOTIFY_ENABLED=true
#SYNC_PG_NOTIFY_MAX_RECONNECT_ATTEMPTS=5
#SYNC_DB_POLLING_ENABLED=true
#SYNC_DB_POLLING_BATCH_SIZE=50
#SYNC_DB_POLLING_INTERVAL_MS=30000

# Microservice mode
#ENDPOINT_HOST=localhost
#ENDPOINT_PORT=6380
#CORE_API_URL=
#CORE_API_URL_USERNAME=
#CORE_API_URL_PASSWORD=
#INTERNAL_API_KEY_ENDPOINT=
#INTERNAL_MONOLITH_SERVICES=endpoint

# Admin runtime
#REVISIUM_CLIENT_DIR=
#REACT_APP_ENDPOINT_SERVER_URL=
#REACT_APP_ENDPOINT_HOST=
#REACT_APP_ENDPOINT_PORT=
#REACT_APP_SWAGGER_SERVER_URL=
#REACT_APP_GRAPHQL_SERVER_URL=
#REACT_APP_GRAPHQL_SERVER_PROTOCOL=
#REACT_APP_GRAPHQL_SERVER_HOST=
#REACT_APP_GRAPHQL_SERVER_PORT=
#REACT_APP_CETRIFUGE_PROTOCOL=
#REACT_APP_CETRIFUGE_HOST=
#REACT_APP_CETRIFUGE_PORT=

# Metrics and shutdown
GRACEFUL_SHUTDOWN_TIMEOUT=10000
METRICS_ENABLED=false

# Enterprise / licensing / billing
#REVISIUM_LICENSE_KEY=
#REVISIUM_BILLING_ENABLED=false
#REVISIUM_SSO_ENABLED=false
#REVISIUM_AUDIT_ENABLED=false
#PAYMENT_SERVICE_URL=
#PAYMENT_SERVICE_SECRET=

# API key limits
#API_KEY_MAX_PER_USER=10
#API_KEY_MAX_SERVICE_PER_ORG=100

# Seed tooling
#SEED_OPENAPI_URL=
#SEED_URL=
